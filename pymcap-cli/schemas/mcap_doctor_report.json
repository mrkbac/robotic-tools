{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DoctorOutputRecord",
  "description": "One JSONL record emitted by `pymcap-cli doctor --format jsonl`.",
  "oneOf": [
    { "$ref": "#/definitions/DoctorFindingOutput" },
    { "$ref": "#/definitions/DoctorSummaryOutput" }
  ],
  "definitions": {
    "DoctorFindingOutput": {
      "title": "DoctorFindingOutput",
      "type": "object",
      "required": [
        "schema_version",
        "type",
        "code",
        "severity",
        "offset",
        "section",
        "record",
        "message"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "type": { "const": "finding" },
        "code": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["error", "warning", "info"] },
        "offset": { "type": ["integer", "null"], "minimum": 0 },
        "section": {
          "enum": [
            "unknown",
            "data",
            "summary",
            "summary-offset",
            "footer",
            "after-footer"
          ]
        },
        "record": { "type": "string" },
        "message": { "type": "string" }
      },
      "additionalProperties": false
    },
    "DoctorSummaryOutput": {
      "title": "DoctorSummaryOutput",
      "type": "object",
      "required": [
        "schema_version",
        "type",
        "path",
        "records",
        "messages",
        "chunks",
        "errors",
        "warnings",
        "info",
        "complete"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "type": { "const": "summary" },
        "path": { "type": "string" },
        "records": { "type": "integer", "minimum": 0 },
        "messages": { "type": "integer", "minimum": 0 },
        "chunks": { "type": "integer", "minimum": 0 },
        "errors": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "info": { "type": "integer", "minimum": 0 },
        "complete": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  }
}
